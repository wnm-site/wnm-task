# ─────────────────────────────────────────────────────────────
# RewardHub API — environment variables
# Copy this file to `.env` locally. On Vercel, set these in:
#   Vercel Dashboard → Project ("server") → Settings →
#   Environment Variables  (NOT in .env — Vercel ignores .env)
# ─────────────────────────────────────────────────────────────
PORT=5000

# MongoDB connection string (ensure 0.0.0.0/0 or a fixed IP
# range is whitelisted in Atlas Network Access for Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rewardhub?retryWrites=true&w=majority

# JWT secret used to sign auth tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

NODE_ENV=development

# Deployed frontend URLs allowed by CORS.
# FRONTEND_URL keeps its single-origin behavior for backwards compat.
FRONTEND_URL=http://localhost:5173

# Extra CORS origins as a comma-separated list (the Netlify production and
# preview domains are already allowed by default, so this is only needed for
# additional custom domains).
ALLOWED_ORIGINS=https://task2rewards.netlify.app